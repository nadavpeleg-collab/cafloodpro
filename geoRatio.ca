// Compute the geographic ratio for each cell of the grid.
// This is the dx/dy ratio which change depending on the lat/long position.
// The dy value do not change, only the dx. 
// R is the earth radious in KM.
// l is the length of a side in radian.
// ATTENTION This work only on a regular square grid.

CA_FUNCTION geoRatio(CA_GRID grid, CA_CELLBUFF_REAL_IO  RATIO,  
		     CA_GLOB_REAL_I dy, CA_GLOB_REAL_I R, CA_GLOB_REAL_I l)
{
  // Initialise the grid
  CA_GRID_INIT(grid);
    
  // Get the YCoordinate of the centre of the cell in radian .
  CA_REAL  ycoo = caYCoo(grid,0)*(PI/180.0);

  // Get the dx in meters using the Equirectangular approximation
  CA_REAL  dx = caAbsReal( (l)*caCosReal(ycoo) * R * 1000 );
  
  // Write the dx/dy ratio
  caWriteCellBuffReal(grid,RATIO,(dx/dy));  
}
