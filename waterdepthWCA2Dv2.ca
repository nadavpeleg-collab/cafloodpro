// Update the water depth for the WCA2Dv2 model.
// The Water depth of the boundary cells (bit 31
// mask) is updated. The bounday cell should have only influx.
// Thi version erase OUTF2.

// ATTENTION, This version add later flux.  It uses the spatial RAIN
// from a table. The indices are retrieved from the special bits of
// the mask which position are passed as argoments in spos epos
// (start/end).

#ifdef cl_nv_pragma_unroll
#pragma OPENCL EXTENSION cl_nv_pragma_unroll : enable
#endif

CA_FUNCTION waterdepthWCA2Dv2(CA_GRID grid, CA_CELLBUFF_REAL_IO WD, CA_EDGEBUFF_REAL_I OUTF1, 
			      CA_EDGEBUFF_REAL_IO OUTF2, 
			      CA_CELLBUFF_STATE_I MASK, 
			      CA_TABLE_REAL_I RAIN, CA_GLOB_STATE_I spos, CA_GLOB_STATE_I epos,
			      CA_GLOB_REAL_I dt, CA_GLOB_REAL_I updatedt)
{
  // Initialise the grid
  CA_GRID_INIT(grid);

  // ERASE OUTF BUFFER 2
  for(int k=1; k<=caUpdateEdges(grid); ++k)
    caWriteEdgeBuffReal(grid,OUTF2,k,0.0);

  // Create the array which will contain the water fluxes on the
  // edges.
  CA_ARRAY_CREATE(grid, CA_REAL, FLUXES, caEdges+1);

  // Read Mask.
  CA_STATE mask  = caReadCellBuffState(grid,MASK,0);

  // Read bit 0  (false the main cell has nodata)
  CA_STATE bit0  = caReadBitsState(mask,0,1);

  // Read bit 31 (true if the main cell is nodata in at least one
  // neighbour has data)
  CA_STATE bit31  = caReadBitsState(mask,31,32);

  // If the main cell has no data and none of the neighbour has data,
  // then do nothing.
  if(bit0 == 0 && bit31 == 0)
    return;

  // Retrieve the 0 of the spatial rain.
  CA_STATE idx = caReadBitsState(mask,spos,epos);

  // Read the fluxes of the main cell.
  caReadEdgeBuffRealEdgeArray(grid, OUTF1,0, FLUXES);

  // Retrive the current value of the water depth.
  CA_REAL  wd  = caReadCellBuffReal(grid,WD,0);
  
  // Reteieve the rain from the table.
  CA_REAL rain = caReadTableReal(grid,RAIN,idx);

  // Retrive the area of the main cell.
  CA_REAL  area = caArea(grid,0);

  CA_REAL outflux = 0.0;

  // Loop through the edges.
#pragma unroll
  for(int e=1; e<=caEdges; e++)
  {
    // If the edge is one of the edges that can be updated without
    // overwriting the buffer, the outflux is positive otherwise is
    // negative.
    if(e<=caUpdateEdges(grid))
      outflux += FLUXES[e];
    else
      outflux -= FLUXES[e];    
  }
  
  // Remove the outflux volume from the next step of the water depth.
  // Add the rain
  caWriteCellBuffReal(grid,WD,wd-(outflux/area)+rain);

}
