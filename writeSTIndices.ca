// Write the spatial temporal indices from SRC buffer into the
// specific bits of the DST buffer.  The code mantains ins DST the
// original values in all the other bits.  If src is nodata or is
// greater than the given maximum value, then write zero in the
// destination.
CA_FUNCTION writeSTIndices(CA_GRID grid, CA_CELLBUFF_STATE_IO DST, CA_CELLBUFF_STATE_I SRC, 
			   CA_GLOB_STATE_I start, CA_GLOB_STATE_I stop, 
			   CA_GLOB_STATE_I nodata, CA_GLOB_STATE_I max)
{
  // Initialise the grid
  CA_GRID_INIT(grid);

  // Read src and dst values..
  CA_STATE src  = caReadCellBuffState(grid,SRC,0);
  CA_STATE dst  = caReadCellBuffState(grid,DST,0);

  if(src == nodata || src>max || src<0)
    src = 0;

  // Write src into dst using the specific bits.
  dst = caWriteBitsState( src, dst, start, stop);  

  // Update the DST buffer.
  caWriteCellBuffState(grid,DST,dst);  
}
