// computer band codes given a set of band values

CA_FUNCTION banding(CA_GRID grid, 
				CA_CELLBUFF_REAL_IO WD,
				CA_CELLBUFF_STATE_IO BANDED_GRID,
				CA_TABLE_REAL_I BANDS,
				CA_CELLBUFF_STATE_I MASK,
				CA_GLOB_STATE_I numberOfBands
				)
{
  // Initialise the grid
  CA_GRID_INIT(grid);
  
  // Read Mask.
  CA_STATE mask  = caReadCellBuffState(grid,MASK,0);

  // Read bit 0  (false the main cell has nodata)
  CA_STATE bit0  = caReadBitsState(mask,0,1);

  // Read bit 31 (true if the main cell is nodata in at least one
  // neighbour has data)
  CA_STATE bit31  = caReadBitsState(mask,31,32);

  // If the main cell has no data and none of the neighbour has data,
  // then do nothing.
  if(bit0 == 0 && bit31 == 0)
    return;
	
	//----------------------------------------
	
	// Retrive the current value of the water depth.
	CA_REAL  wd  = caReadCellBuffReal(grid,WD,0);
	
	
	
	// bands assumed to start at zero depth
	CA_REAL  lastBand  = 0.0;
	
	CA_STATE band = 0;
	
	for ( unsigned int counter = 0; counter < numberOfBands; ++counter)
	{
		
		// Reteieve the band from the table.
		CA_REAL bandUpperLimit = caReadTableReal(grid,BANDS,counter);
		
		// if we're not the first band, we need a new lower level of the band
		if(counter != 0){
			lastBand  = caReadTableReal(grid,BANDS,counter-1);;
		}
		
		
		if(wd >= lastBand && wd < bandUpperLimit)
		{
			
			band = counter +1;
			
		}
		
		
		
	}// end of looping to find band
  
  // write the band
  caWriteCellBuffState(grid,BANDED_GRID, band );
  

}// end of banding ca function
