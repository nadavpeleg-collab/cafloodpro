// This kernel checks each cell if it has reach the threshold level,
// and when it does, records the simulation time for that cell.


CA_FUNCTION timeToThreshold(CA_GRID grid, 
			   CA_CELLBUFF_REAL_I ELV, CA_CELLBUFF_REAL_I WD, 
			   CA_CELLBUFF_STATE_I MASK, CA_ALARMS_O ALARMS,
			   CA_CELLBUFF_REAL_IO TIME, 
			   CA_GLOB_REAL_I ignore_wd, CA_GLOB_REAL_I threshold_wd,
			   CA_GLOB_REAL_I currentTime,CA_GLOB_REAL_I noData)
{					       
  // Initialise the grid
  CA_GRID_INIT(grid);

  // Read Mask.
  CA_STATE mask  = caReadCellBuffState(grid,MASK,0);

  // Retrieve the water depth of the main cell.
  CA_REAL  wdmain = caReadCellBuffReal(grid,WD,0);
  
  // Retrieve the current data, to dettermine if the threshold has been passed already or not
  CA_REAL  time_main = caReadCellBuffReal(grid,TIME,0);

  // Read bit 0  (false the main cell has nodata)
  CA_STATE bit0  = caReadBitsState(mask,0,1);

  // Retrieve the 0 of the spatial roughness.
  //CA_STATE idx = caReadBitsState(mask,spos,epos);

  // If the main cell has no data (bit0 is false ) or there is no
  // water do not compute the cell.
  if(!(bit0 == 0 ||  wdmain < ignore_wd))
  {
    
	// check if water depth is greater than record the current time in the cell
	if( wdmain > threshold_wd  && time_main == noData){
	
		// Update the maximum value.
		caWriteCellBuffReal(grid,TIME,currentTime);
	
	}
	
  } // Now water or no data cell.

}// end of kernel
