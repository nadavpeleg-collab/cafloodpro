CA_FUNCTION checkFloodNoDataNeighbourhood(CA_GRID grid, 
			   CA_CELLBUFF_REAL_I ELV, CA_CELLBUFF_REAL_I WD, 
			   CA_CELLBUFF_STATE_I MASK,
			   CA_CELLBUFF_STATE_IO RESULT,
			   CA_GLOB_REAL_I noData)
{					       
	// Initialise the grid
	CA_GRID_INIT(grid);
	
	// Read Mask.
	CA_STATE mask  = caReadCellBuffState(grid,MASK,0);
	
	// Retrieve the water depth of the main cell.
	CA_REAL  wdmain = caReadCellBuffReal(grid,WD,0);
	
	// Read bit 0  (false the main cell has nodata)
	CA_STATE bit0  = caReadBitsState(mask,0,1);
	
	// Read bit 29 (true if in border)
	//CA_STATE bit29  = caReadBitsState(mask,29,30);


	
	//-------------------------
	// only check cells with water in them
	if(wdmain > 0.0){
		
		//
		CA_STATE code  = 0;
	
		// create arrays to store the neighbouring elevations 
		CA_ARRAY_CREATE(grid, CA_REAL, elevations,caNeighbours+1);
		
		//and water depths
		//CA_ARRAY_CREATE(grid, CA_REAL, waterDepths,caNeighbours+1);

		CA_ARRAY_CREATE(grid, CA_STATE, masks,caNeighbours+1);

		// Read the elvations of the neighbourhood cells (store temporarily into ELV).
		caReadCellBuffRealCellArray(grid,ELV,elevations);

		caReadCellBuffStateCellArray(grid,MASK,masks);


		// if main cell is no_data and wet, state 1 ---should never happen?! code therefore cuaght before this kernel???
		if(bit0 == 0){
			//caWriteCellBuffState(grid,RESULT,1);
			code = 1;

		}
		
		CA_STATE neighbourWithNoData  = false;
		CA_STATE neighbourWithBorder  = false;
		
		
		#pragma unroll
		for(int k=1; k<=caNeighbours; ++k){
		  //WATER[k]=caMinReal(WATER[0] - WATER[k], wdmain); 
		  
		  if(elevations[k] == noData){
			neighbourWithNoData  = true;
		  }

		  if(caReadBitsState(masks[k],29,30)==1){
			neighbourWithBorder  = true;
		  }
		  
		}// end of looping neighbours
		
		// if neighbouring cell is no_data and main wet, state 2
		if(neighbourWithNoData){
			//caWriteCellBuffState(grid,RESULT,2);
			code = 2;
		}

		// if this cell is wet and neighbour a actual border, then code 4
		if(neighbourWithBorder){
			code = 4;
		}
		
		//caWriteCellBuffState(grid,RESULT,2);
		caWriteCellBuffState(grid,RESULT,code);
		
	}

}// end of CA function


